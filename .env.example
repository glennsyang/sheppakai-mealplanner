NODE_ENV=development
# Database
DATABASE_URL=data/db.sqlite
# Authentication
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_BASE_URL=http://localhost:5173
# Email Service (Brevo — https://developers.brevo.com/guides/node-js)
BREVO_API_KEY=xkeysib-your_api_key_here
# Must be a sender address confirmed in Brevo (6-digit code flow). New Brevo
# accounts also need a one-time manual sending approval before delivery works.
# The literal `noreply@example.com` is rejected at runtime (it's the build-time dummy).
BREVO_FROM_ADDRESS=your-verified-sender@example.com
# AI
GEMINI_API_KEY=gemini_your_api_key_here