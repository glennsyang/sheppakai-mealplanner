NODE_ENV=development
# Database
DATABASE_URL=data/db.sqlite
# Authentication
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_BASE_URL=http://localhost:5173
# Email Service
RESEND_API_KEY=re_your_api_key_here
# Use a verified sending domain in prod; `onboarding@resend.dev` works for local dev.
# The literal `noreply@example.com` is rejected at runtime (it's the build-time dummy).
RESEND_FROM_ADDRESS=onboarding@resend.dev
RESEND_NEW_USER_ADDRESS=admin@example.com
# AI
GEMINI_API_KEY=gemini_your_api_key_here