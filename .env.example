# Full reference (scope, required/optional, defaults, where each is consumed): docs/ENVIRONMENT.md
NODE_ENV=development
# Database
DATABASE_URL=data/db.sqlite
# Authentication
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_BASE_URL=http://localhost:5173
# Comma-separated user IDs bootstrapped as admins by the better-auth admin plugin.
# Defaults to `dummy_admin_id`; promote a real admin here or via a one-off SQL UPDATE.
ADMIN_USER_IDS=your_admin_user_id_here
# Email Service (Brevo — https://developers.brevo.com/guides/node-js)
BREVO_API_KEY=xkeysib-your_api_key_here
# Must be a sender address confirmed in Brevo (6-digit code flow). New Brevo
# accounts also need a one-time manual sending approval before delivery works.
# The literal `noreply@example.com` is rejected at runtime (it's the build-time dummy).
BREVO_FROM_ADDRESS=your-verified-sender@example.com
# AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=gemini_your_api_key_here

# --- Optional — not needed for `npm run dev`, uncomment/set only if you need them ---
# Ntfy.sh URL for security/auth push alerts (e.g. completed password resets).
# Unset → defaults to a non-resolving `.invalid` host and alerts are disabled
# (nothing is sent anywhere). Set a real URL only where you want delivery.
# AUTH_ALERTS_URL=https://ntfy.sh/your-topic
# Sentry DSN — defaults to the project DSN, only override for a different Sentry project.
# PUBLIC_SENTRY_DSN=https://...ingest.sentry.io/...
# Sentry auth token — only read during `npm run build`, to upload source maps. Unset locally is fine.
# SENTRY_AUTH_TOKEN=
# Log verbosity override (debug|info|warn|error) — defaults to debug in dev, info in production.
# LOG_LEVEL=debug